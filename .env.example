# =============================================================================
# Arciv MVP Configuration
# =============================================================================
# Copy this file to .env and update the values for your environment.

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL connection URL. Required.
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://arciv:arciv@db:5432/arciv

# =============================================================================
# Redis Configuration
# =============================================================================
# Redis connection URL for job queue and caching. Required.
REDIS_URL=redis://redis:6379/0

# =============================================================================
# Authentication Configuration
# =============================================================================
# Secret key for JWT token signing. Required.
# Generate with: openssl rand -hex 32
SECRET_KEY=change_me_generate_with_openssl_rand_hex_32

# JWT algorithm. Keep default unless you have specific requirements.
ALGORITHM=HS256

# JWT access token expiration in minutes (default: 15). Kept short because a
# long-lived refresh token now handles staying logged in.
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime in days (DB-backed, rotated on use, revocable).
REFRESH_TOKEN_EXPIRE_DAYS=30

# Single-use email-token lifetimes (stored in Redis).
VERIFY_TOKEN_TTL_HOURS=24
RESET_TOKEN_TTL_HOURS=1

# =============================================================================
# Security Configuration
# =============================================================================
# AES-256 encryption key for storing API keys securely. Required.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=change_me_generate_with_openssl_rand_hex_32
# Version label for the active ENCRYPTION_KEY, stamped into every new
# envelope-encrypted secret. Bump it when you rotate the key.
ENCRYPTION_KEY_ID=1
# Retired KEKs kept ONLY so old secrets still decrypt during a key rotation.
# Format: "id:secret,id:secret". Leave empty in normal operation.
#
# Rotation runbook:
#   1. Generate a new key:  openssl rand -hex 32
#   2. Set ENCRYPTION_KEYS_RETIRED=1:<current ENCRYPTION_KEY>
#   3. Set ENCRYPTION_KEY=<new key> and ENCRYPTION_KEY_ID=2
#   4. Run:  python -m scripts.rotate_encryption_key
#   5. Once it completes, clear ENCRYPTION_KEYS_RETIRED (old key no longer needed).
# No user has to re-enter their provider key — only the wrapping key changes.
ENCRYPTION_KEYS_RETIRED=

# =============================================================================
# Email / SMTP Configuration
# =============================================================================
# Master switch. When false, verification / reset emails are NOT sent — the
# links are logged instead (fine for local dev without an SMTP server).
EMAIL_ENABLED=false

# SMTP server settings. For local dev with the bundled MailHog container:
#   EMAIL_ENABLED=true SMTP_HOST=mailhog SMTP_PORT=1025 SMTP_STARTTLS=false
# For production use your provider (Mailgun, SES, Postfix, Gmail, ...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Arciv <no-reply@arciv.local>
SMTP_STARTTLS=true

# --- Gmail API backend (HTTPS, port 443) ---------------------------------
# Use this INSTEAD of SMTP when your host blocks outbound SMTP ports — e.g.
# Render's free/starter tier blocks 25/465/587, so smtp.gmail.com times out.
# When GMAIL_REFRESH_TOKEN is set, mail is sent via the Gmail REST API over
# 443 from your authenticated Gmail account. Set EMAIL_ENABLED=true and point
# SMTP_FROM at the SAME Gmail address (Gmail rewrites a mismatched From),
# e.g. SMTP_FROM=Arciv <youraddr@gmail.com>. SMTP_* are then ignored.
# One-time setup (Google Cloud → enable Gmail API → OAuth client → mint a
# refresh token with scope https://www.googleapis.com/auth/gmail.send):
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Public base URL of THIS deployment. Used to build verification / reset links
# in emails (the worker has no HTTP request to infer it from), so it must be set
# correctly in production, e.g. APP_BASE_URL=https://arciv.example.com
APP_BASE_URL=http://localhost:8000

# Comma-separated browser origins allowed by CORS. APP_BASE_URL is added
# automatically. Add your frontend origin(s) here if served separately.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# =============================================================================
# AI Provider Configuration
# =============================================================================
# Shared Gemini API key for free tier users (optional).
# If provided, new users get AI processing without configuring their own key.
# Get your key from: https://makersuite.google.com/app/apikey
SHARED_GEMINI_KEY=

# --- Semantic search embeddings (local, no API key) ----------------------
# Links get a vector (via fastembed / ONNX, in-container) so search matches by
# meaning, not just substrings. No key, works offline, private. Set to false on
# very low-RAM hosts — saves still work, /api/links/search returns 503, and the
# UI falls back to substring filtering.
EMBEDDINGS_ENABLED=true
# Embedding model. Changing it usually changes the vector dimension, which is
# fixed in the DB (Vector(384) in migration 0012) — a different-dim model needs
# a new migration. Leave as-is unless you know what you're doing.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Max simultaneous in-process embeddings. fastembed is CPU-bound, so a burst of
# saves or searches can otherwise pin every core and starve request handling.
# Keep <= (CPU cores - 1) so the event-loop thread always keeps a core. Applies
# per process (api and worker each get their own), which globally bounds embed
# load on a single-box deploy. Raise it on a bigger host.
EMBEDDING_MAX_CONCURRENCY=2
# Cache search-query embeddings in Redis so repeat searches skip the CPU embed.
# Seconds; 0 disables. Falls back gracefully (just re-embeds) if Redis is down.
SEARCH_EMBED_CACHE_TTL=3600

# =============================================================================
# Telegram Bot Configuration
# =============================================================================
# Master switch for all Telegram features (bot, /api/telegram/* routes, and the
# daily-digest cron). Disabled by default. To enable:
#   1. Set TELEGRAM_ENABLED=true
#   2. Set TELEGRAM_BOT_TOKEN below
#   3. Start the bot service: docker compose --profile telegram up
TELEGRAM_ENABLED=false

# Telegram bot token. Required only when TELEGRAM_ENABLED=true.
# Create a bot with @BotFather on Telegram and paste the token here.
TELEGRAM_BOT_TOKEN=

# =============================================================================
# Feed Polling Configuration
# =============================================================================
# Cron expression for when to poll all feeds for new content (default: 08:00 UTC daily).
# Format: minute hour day-of-month month day-of-week
# Examples:
#   "0 8 * * *"    - Daily at 8:00 UTC
#   "0 */6 * * *"  - Every 6 hours
#   "30 9,21 * * *" - Daily at 9:30 AM and 9:30 PM UTC
FEED_POLL_CRON=0 8 * * *

# =============================================================================
# HTTP Client Configuration
# =============================================================================
# User-Agent header sent on outbound HTTP requests (feed discovery, feed polling,
# link metadata fetch). Self-hosters: include a contact URL or email so site
# operators you crawl can reach you. RFC 9110 recommends this for any
# automated client.
# USER_AGENT=Arciv/0.1 (+https://your-instance.example.com)

# =============================================================================
# Public-Launch Abuse / DoS Guards
# =============================================================================
# All default to "off" so self-hosting is unrestricted. A public, multi-tenant
# deployment should set real ceilings. Rate limits are per-user fixed-window
# Redis counters; quotas are per-user row counts (0 = unlimited).
#
# Per-user rate limits — burst/anti-spam guards, NOT usage caps. AI is BYO-key
# (per-call cost is the user's, not the operator's), so these only protect the
# server from a script hammering it. Per-MINUTE: high enough no human notices,
# low enough to stop a flood. Set 0 to disable any one.
LINKS_CREATE_PER_MINUTE=20  # POST /api/links (metadata fetch + enqueue)
SEARCH_PER_MINUTE=30        # GET /api/links/search (each call runs an embedding)
INSIGHTS_PER_MINUTE=10      # POST /api/links/:id/insights (inline LLM call, heaviest)
#
# Per-user resource quotas (0 = unlimited; hosted might use e.g. 5000 / 200):
MAX_LINKS_PER_USER=0
MAX_FEEDS_PER_USER=0
#
# Registration-abuse controls:
BLOCK_DISPOSABLE_EMAILS=false   # reject known throwaway email domains at signup
SIGNUPS_PER_DAY_GLOBAL=0        # 0 = unlimited; global daily new-account ceiling

# =============================================================================
# Environment Configuration
# =============================================================================
# Environment type. Keep as "development" for local testing.
# Set to "production" for deployment.
ENVIRONMENT=development

# =============================================================================
# Optional: Docker Compose Overrides
# =============================================================================
# If you're using custom ports or service names, you may need to override these:
# DATABASE_URL=postgresql://arciv:arciv@localhost:5432/arciv
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Getting Started Guide
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Generate secrets: 
#    openssl rand -hex 32  # for SECRET_KEY
#    openssl rand -hex 32  # for ENCRYPTION_KEY
# 3. Add your API keys (optional but recommended)
# 4. Run: docker compose up -d
# 5. Visit: http://localhost:8000
#
# For detailed setup instructions, see README.md

# Comma-separated emails granted admin access (user management panel at /admin).
ADMIN_EMAILS=
