# Database
DATABASE_URL=postgresql://arciv:arciv@db:5432/arciv

# Redis
REDIS_URL=redis://redis:6379/0

# JWT — generate with: openssl rand -hex 32
SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AES-256 encryption key for API keys — generate with: openssl rand -hex 32
ENCRYPTION_KEY=change_me_generate_with_openssl_rand_hex_32

# Telegram bot (optional)
TELEGRAM_BOT_TOKEN=

# Shared Gemini API key (optional — free tier for new users)
SHARED_GEMINI_KEY=

# Feed polling cron (default: 08:00 UTC daily)
FEED_POLL_CRON=0 8 * * *

# Environment
ENVIRONMENT=development
